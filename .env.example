API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=123456:your_bot_token
SESSION_NAME=watcher
DB_PATH=gifts.db
REQUESTS_PER_SECOND=5
REFRESH_MINUTES=60
EXTRA_COLLECTIONS=

# ---- Владелец и подписки ----
# Владелец: доступ без подписки, подтверждает оплату. Пусто (и без ADMIN_IDS) = подписки выключены.
OWNER_USERNAME=Roiz14
# Дополнительные владельцы по числовому id (узнать: /id у бота), через запятую. Необязательно.
ADMIN_IDS=
# Кому отправлять подарки в оплату (без @). По умолчанию = владелец.
PAY_USERNAME=Roiz14
# Реквизиты для оплаты рублями (показываются покупателю). Пусто = способ скрыт.
RUB_DETAILS=
# Адрес кошелька для GRAM. Пусто = способ скрыт.
GRAM_DETAILS=
# Курс: сколько рублей стоит 1 GRAM. Все цены в GRAM и минимальная цена NFT-подарка считаются по нему.
# Курс меняется, обновляй вручную и перезапускай бота.
GRAM_RUB_RATE=97.44
# Оплата рублями картой автоматически: токен платёжного провайдера.
# @BotFather -> /mybots -> твой бот -> Payments -> выбрать провайдера -> скопировать токен. Пусто = перевод вручную.
PROVIDER_TOKEN=
